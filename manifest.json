{
  "manifest_version": 3,
  "name": "Screen Notes — 영상 화면 AI 노트",
  "version": "0.2.0",
  "description": "재생 중인 영상 화면에서 학습 노트를 만듭니다. 화면 이미지는 기기 안에서만 처리되며 어디에도 저장되지 않습니다.",
  "permissions": ["storage", "sidePanel", "scripting", "tabs"],
  "host_permissions": ["https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Screen Notes 열기"
  }
}
