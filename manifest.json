{
  "manifest_version": 3,
  "name": "Summrizei — 강의 노트",
  "version": "0.2.0",
  "description": "재생 중인 영상 화면에서 학습 노트를 만듭니다. 화면 이미지는 기기 안에서만 처리되며 어디에도 저장되지 않습니다.",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "tabCapture",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://openrouter.ai/*"
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Summrizei 열기 · Alt+Shift+S",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "open-capture-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "현재 강의 탭의 캡처 창 열기 (LearnUs 팝업용)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"
  },
  "minimum_chrome_version": "116"
}
