{
  "manifest_version": 3,
  "name": "Summrizei — 강의 노트",
  "version": "1.2.2",
  "description": "재생 중인 강의 영상의 화면·음성으로 학습 노트를 만듭니다. 완성된 노트는 이 컴퓨터에 암호화해 저장하고 Summrizei 웹사이트에서 엽니다.",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "tabCapture",
    "offscreen",
    "activeTab",
    "identity",
    "power",
    "declarativeNetRequestWithHostAccess",
    "unlimitedStorage",
    "downloads"
  ],
  "optional_permissions": ["webRequest"],
  "host_permissions": [
    "<all_urls>",
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://cdn-lfs.huggingface.co/*"
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Summrizei 열기 · Alt+Shift+S",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "open-capture-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "현재 강의 탭의 캡처 창 열기 (LearnUs 팝업용)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"
  },
  "minimum_chrome_version": "116"
}
